# Local-only files
.DS_Store
backend/venv/

# SQLite temporary files written while the server runs
*.db-shm
*.db-wal

# Per-installation secret signing key
backend/secret.key

# Windows installer build output
windows/build/
windows/dist/
windows/output/
downloads/
*.spec.bak

# Compiled Python in the Windows build folder
windows/**/__pycache__/

# Live database: created on first run, never committed
backend/queue.db

# Infomercial videos uploaded by the admin: user data, never committed
backend/media/

# Compiled Python
*.pyc
